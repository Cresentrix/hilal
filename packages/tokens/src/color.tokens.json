{
  "color": {
    "brand": {
      "50":  { "$value": "#e0f2fa", "$type": "color" },
      "100": { "$value": "#b3e0f5", "$type": "color" },
      "200": { "$value": "#80cce9", "$type": "color" },
      "300": { "$value": "#4db8dd", "$type": "color" },
      "400": { "$value": "#26a3d1", "$type": "color" },
      "500": { "$value": "#0090c6", "$type": "color" },
      "600": { "$value": "#0074ac", "$type": "color" },
      "700": { "$value": "#006399", "$type": "color" },
      "800": { "$value": "#00537f", "$type": "color" },
      "900": { "$value": "#004366", "$type": "color" },
      "950": { "$value": "#001f33", "$type": "color" }
    },
    "neutral": {
      "0":   { "$value": "#ffffff", "$type": "color" },
      "50":  { "$value": "#fafafa", "$type": "color" },
      "100": { "$value": "#f5f5f5", "$type": "color" },
      "200": { "$value": "#eeeeee", "$type": "color" },
      "300": { "$value": "#e0e0e0", "$type": "color" },
      "400": { "$value": "#bdbdbd", "$type": "color" },
      "500": { "$value": "#9e9e9e", "$type": "color" },
      "600": { "$value": "#757575", "$type": "color" },
      "700": { "$value": "#616161", "$type": "color" },
      "800": { "$value": "#424242", "$type": "color" },
      "900": { "$value": "#212121", "$type": "color" },
      "950": { "$value": "#121212", "$type": "color" }
    },
    "success": {
      "100": { "$value": "#b8ffd5", "$type": "color" },
      "500": { "$value": "#00c853", "$type": "color" },
      "700": { "$value": "#00863a", "$type": "color" }
    },
    "warning": {
      "100": { "$value": "#fff3b8", "$type": "color" },
      "500": { "$value": "#ffb300", "$type": "color" },
      "700": { "$value": "#cc8a00", "$type": "color" }
    },
    "danger": {
      "100": { "$value": "#ffd6d6", "$type": "color" },
      "500": { "$value": "#e53935", "$type": "color" },
      "700": { "$value": "#a52121", "$type": "color" }
    }
  },
  "fg": {
    "default":   { "$value": "{color.neutral.900}", "$type": "color" },
    "muted":     { "$value": "{color.neutral.600}", "$type": "color" },
    "subtle":    { "$value": "{color.neutral.500}", "$type": "color" },
    "on-brand":  { "$value": "{color.neutral.0}",   "$type": "color" },
    "on-danger": { "$value": "{color.neutral.0}",   "$type": "color" }
  },
  "bg": {
    "default": { "$value": "{color.neutral.0}",   "$type": "color" },
    "muted":   { "$value": "{color.neutral.50}",  "$type": "color" },
    "subtle":  { "$value": "{color.neutral.100}", "$type": "color" }
  },
  "border": {
    "default": { "$value": "{color.neutral.300}", "$type": "color" },
    "muted":   { "$value": "{color.neutral.200}", "$type": "color" },
    "strong":  { "$value": "{color.neutral.500}", "$type": "color" }
  },
  "accent": {
    "default": { "$value": "{color.brand.500}", "$type": "color" },
    "hover":   { "$value": "{color.brand.600}", "$type": "color" },
    "pressed": { "$value": "{color.brand.700}", "$type": "color" }
  }
}
