{
  "elevation": {
    "0":     { "$value": "0 0 0 0 rgba(0, 0, 0, 0)",          "$type": "shadow" },
    "inner": { "$value": "inset 0 2px 4px rgba(0, 0, 0, 0.10)", "$type": "shadow" },
    "focus": { "$value": "0 0 0 3px rgba(223, 245, 255, 1.00)", "$type": "shadow" },
    "1":     { "$value": "0 1px 3px rgba(0, 0, 0, 0.25)",     "$type": "shadow" },
    "2":     { "$value": "0 2px 6px rgba(0, 0, 0, 0.16)",     "$type": "shadow" },
    "3":     { "$value": "0 4px 12px rgba(0, 0, 0, 0.18)",    "$type": "shadow" },
    "4":     { "$value": "0 8px 16px rgba(0, 0, 0, 0.20)",    "$type": "shadow" },
    "5":     { "$value": "0 12px 24px rgba(0, 0, 0, 0.25)",   "$type": "shadow" }
  },
  "motion": {
    "duration": {
      "instant": { "$value": "0ms",   "$type": "duration" },
      "fast":    { "$value": "120ms", "$type": "duration" },
      "base":    { "$value": "200ms", "$type": "duration" },
      "slow":    { "$value": "320ms", "$type": "duration" }
    },
    "easing": {
      "standard":   { "$value": "cubic-bezier(0.2, 0, 0, 1)",   "$type": "cubicBezier" },
      "emphasized": { "$value": "cubic-bezier(0.3, 0, 0.1, 1)", "$type": "cubicBezier" },
      "decelerate": { "$value": "cubic-bezier(0, 0, 0, 1)",     "$type": "cubicBezier" },
      "accelerate": { "$value": "cubic-bezier(0.3, 0, 1, 1)",   "$type": "cubicBezier" }
    }
  }
}
