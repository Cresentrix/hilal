{
  "font": {
    "family": {
      "sans":   { "$value": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "$type": "fontFamily" },
      "arabic": { "$value": "'Noto Kufi Arabic', 'Inter', sans-serif", "$type": "fontFamily" },
      "mono":   { "$value": "ui-monospace, 'JetBrains Mono', 'Menlo', monospace", "$type": "fontFamily" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },
    "size": {
      "12":  { "$value": "0.75rem",    "$type": "dimension" },
      "13":  { "$value": "0.8125rem",  "$type": "dimension" },
      "14":  { "$value": "0.875rem",   "$type": "dimension" },
      "15":  { "$value": "0.9375rem",  "$type": "dimension" },
      "16":  { "$value": "1rem",       "$type": "dimension" },
      "20":  { "$value": "1.25rem",    "$type": "dimension" },
      "24":  { "$value": "1.5rem",     "$type": "dimension" },
      "32":  { "$value": "2rem",       "$type": "dimension" },
      "36":  { "$value": "2.25rem",    "$type": "dimension" },
      "48":  { "$value": "3rem",       "$type": "dimension" },
      "64":  { "$value": "4rem",       "$type": "dimension" },
      "96":  { "$value": "6rem",       "$type": "dimension" },
      "128": { "$value": "8rem",       "$type": "dimension" }
    },
    "lineHeight": {
      "12":  { "$value": "1rem",     "$type": "dimension" },
      "13":  { "$value": "1.25rem",  "$type": "dimension" },
      "14":  { "$value": "1.25rem",  "$type": "dimension" },
      "15":  { "$value": "1.375rem", "$type": "dimension" },
      "16":  { "$value": "1.5rem",   "$type": "dimension" },
      "20":  { "$value": "1.5rem",   "$type": "dimension" },
      "20-loose":  { "$value": "1.75rem", "$type": "dimension" },
      "24":  { "$value": "2rem",     "$type": "dimension" },
      "32":  { "$value": "2.5rem",   "$type": "dimension" },
      "36":  { "$value": "2.75rem",  "$type": "dimension" },
      "48":  { "$value": "3.625rem", "$type": "dimension" },
      "64":  { "$value": "4.875rem", "$type": "dimension" },
      "arabic-12":  { "$value": "1.125rem",  "$type": "dimension" },
      "arabic-13":  { "$value": "1.375rem",  "$type": "dimension" },
      "arabic-14":  { "$value": "1.375rem",  "$type": "dimension" },
      "arabic-15":  { "$value": "1.625rem",  "$type": "dimension" },
      "arabic-16":  { "$value": "1.5rem",    "$type": "dimension" },
      "arabic-20":  { "$value": "1.875rem",  "$type": "dimension" },
      "arabic-24":  { "$value": "2.25rem",   "$type": "dimension" },
      "arabic-32":  { "$value": "2.75rem",   "$type": "dimension" }
    },
    "letterSpacing": {
      "tight":  { "$value": "-0.02em", "$type": "dimension" },
      "normal": { "$value": "0",       "$type": "dimension" },
      "wide":   { "$value": "0.04em",  "$type": "dimension" }
    }
  }
}
