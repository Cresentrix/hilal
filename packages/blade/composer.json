{
  "name": "hilal/blade",
  "description": "Hilal Blade components for Laravel — same DOM and CSS as @hilal/react and @hilal/angular, with Alpine.js for interactivity.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Cresentrix/hilal/tree/main/packages/blade",
  "support": {
    "issues": "https://github.com/Cresentrix/hilal/issues",
    "source": "https://github.com/Cresentrix/hilal"
  },
  "authors": [
    { "name": "Cresentrix", "email": "open-source@cresentrix.com" }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "illuminate/view": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Hilal\\Blade\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Hilal\\Blade\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Hilal\\Blade\\HilalServiceProvider"
      ],
      "aliases": {
        "Hilal": "Hilal\\Blade\\Facades\\Hilal"
      }
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
