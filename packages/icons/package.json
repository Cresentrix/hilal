{
  "name": "@hilal/icons",
  "version": "0.0.1",
  "description": "Hilal icons — curated re-exports of Lucide icons used across the design system. Importing this re-exports lucide-react under the @hilal namespace for naming consistency.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Cresentrix/hilal/tree/main/packages/icons",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cresentrix/hilal.git",
    "directory": "packages/icons"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "clean": "rm -rf dist",
    "lint": "echo 'no lint'",
    "test": "echo 'no tests'",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "lucide-react": "^0.460.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
