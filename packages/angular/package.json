{
  "name": "@hilal/angular",
  "version": "0.0.1",
  "description": "Hilal Angular 19 standalone components. Thin wrappers over @hilal/core CSS — same DOM as the React and Blade packages.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Cresentrix/hilal/tree/main/packages/angular",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cresentrix/hilal.git",
    "directory": "packages/angular"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external @angular/core,@angular/common,rxjs,tslib",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external @angular/core,@angular/common,rxjs,tslib",
    "clean": "rm -rf dist",
    "lint": "echo 'no lint'",
    "test": "echo 'no tests'",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@angular/common": ">=19",
    "@angular/core": ">=19",
    "@hilal/core": "workspace:*"
  },
  "devDependencies": {
    "@angular/common": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@hilal/core": "workspace:*",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
